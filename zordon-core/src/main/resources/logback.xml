<configuration>
    <!-- Log estruturado desde o início: o Zordon é um processo residente e o log é
         a primeira ferramenta de diagnóstico quando ele se comporta mal. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{28} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.java_websocket" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
