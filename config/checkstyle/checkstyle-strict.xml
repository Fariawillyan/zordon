<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Os mesmos limites de checkstyle.xml, 30% mais apertados, para zordon-security
  e zordon-defense (docs/process/code-standards.md §5):

    "Código de segurança que ninguém consegue ler não é código de segurança."
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <!-- Linhas por classe: 700 no resto do projeto. -->
  <module name="FileLength">
    <property name="max" value="490"/>
  </module>

  <module name="TreeWalker">

    <!-- Complexidade ciclomática por método: 15 no resto do projeto. -->
    <module name="CyclomaticComplexity">
      <property name="max" value="10"/>
    </module>

    <!-- Linhas por método: 80 no resto do projeto. -->
    <module name="MethodLength">
      <property name="max" value="56"/>
      <property name="countEmpty" value="false"/>
    </module>

    <!-- Métodos públicos por classe: 20 no resto do projeto. -->
    <module name="MethodCount">
      <property name="maxPublic" value="14"/>
    </module>

    <!-- Parâmetros por método: 6 no resto do projeto. -->
    <module name="ParameterNumber">
      <property name="max" value="4"/>
    </module>
    <!-- Um record com componentes demais é a mesma lista longa de parâmetros. -->
    <module name="RecordComponentNumber">
      <property name="max" value="4"/>
    </module>

    <!-- Profundidade de aninhamento: 5 no resto do projeto. -->
    <module name="NestedIfDepth">
      <property name="max" value="3"/>
    </module>
    <module name="NestedForDepth">
      <property name="max" value="3"/>
    </module>
    <module name="NestedTryDepth">
      <property name="max" value="3"/>
    </module>

    <!-- Dependências de saída por classe: 15 no resto do projeto. -->
    <module name="ClassFanOutComplexity">
      <property name="max" value="10"/>
    </module>

  </module>
</module>
