# ~/.zordon/config.toml — configuração do Zordon
#
# Instalado pelo install.sh só se você ainda não tiver um. Ele nunca sobrescreve
# este arquivo.
#
# Tudo abaixo está comentado: sem nada ativo, o Zordon fala pela ASSINATURA do
# Claude (o `claude` CLI) e só cai na API por chave se a assinatura não estiver
# disponível. Essa é a ordem de preferência — assinatura, servidor local, e a
# chave paga por uso por último (SPEC-018 §3). Descomente o bloco do que você
# tem e reinicie o núcleo:
#
#     sudo systemctl restart zordon
#
# REGRA: este arquivo NUNCA guarda uma chave. Ele guarda o NOME da variável
# (api_key = "env:NOME"); o valor fica em ~/.zordon/secrets.env, gravado por
#     packaging/wsl/set-api-key.sh
# Uma chave escrita aqui é recusada na leitura — de propósito, para este arquivo
# poder ser copiado ou colado num pedido de ajuda sem vazar nada.
#
# Docs: docs/operations/quickstart.md e docs/specs/core/SPEC-004-providers-configuraveis.md

# ─── Providers: quem pode responder ───────────────────────────────────────────

# PRIMEIRA OPÇÃO — assinatura do Claude (Pro/Max) pelo `claude` CLI: sem chave
# nenhuma aqui, e sem cobrança por token. O CLI roda sem ferramentas e sem
# memória própria, pelo caminho auditado do Zordon
# (docs/specs/core/SPEC-018-provider-por-assinatura-claude-cli.md).
# Antes: npm i -g @anthropic-ai/claude-code && claude   (para entrar)
# [ai.providers.claude]
# type = "claude-cli"
#
# Para usar na conversa, em [ai.roles] (mais abaixo):
#   conversation = { provider = "claude", model = "sonnet" }

# ÚLTIMO RECURSO — API da Anthropic (Claude). Paga por uso; precisa de crédito
# na conta. O Zordon só chega aqui se a assinatura não estiver disponível.
# [ai.providers.anthropic]
# type    = "anthropic"
# api_key = "env:ANTHROPIC_API_KEY"

# API da OpenAI. Paga por uso; a assinatura do ChatGPT NÃO inclui a API.
# [ai.providers.openai]
# type     = "openai-compatible"
# base_url = "https://api.openai.com/v1"
# api_key  = "env:OPENAI_API_KEY"

# Modelo local com Ollama: gratuito e sem internet; os dados não saem da máquina.
#   sudo systemctl start ollama && ollama pull qwen2.5:7b
# [ai.providers.ollama]
# type     = "openai-compatible"
# base_url = "http://127.0.0.1:11434/v1"
# max_tokens_param = "max_tokens"

# Qualquer outro serviço compatível com a API da OpenAI (OpenRouter, Groq,
# DeepSeek, LM Studio…) segue o mesmo molde:
# [ai.providers.openrouter]
# type     = "openai-compatible"
# base_url = "https://openrouter.ai/api/v1"
# api_key  = "env:OPENROUTER_API_KEY"      # set-api-key.sh --env OPENROUTER_API_KEY

# ─── Papéis: quem responde o quê ──────────────────────────────────────────────
#
# conversation  a conversa do dia a dia
# fallback      a reserva: entra se a conversa falhar por falta de crédito, chave,
#               limite ou servidor fora do ar — e a tela diz que entrou
#
# effort (opcional): low, medium, high, xhigh, max. Deixe de fora para modelos
# que não raciocinam — alguns servidores recusam o pedido se ele vier.
#
# Confira o nome exato do modelo no seu provider; o Zordon não adivinha.

# Sem esta seção vale a ordem de preferência: assinatura primeiro, servidor
# local depois, chave paga por uso por último. Declarar um papel aqui é dizer
# "eu quero este mesmo" — e aí a ordem não se aplica a ele.

# [ai.roles]
# conversation = { provider = "claude",    model = "opus" }
# fallback     = { provider = "anthropic", model = "claude-sonnet-5" }

# ─── Servidores MCP (docs/specs/mcp/SPEC-020-cliente-mcp.md) ──────────────────
#
# Cada servidor é um processo filho, pelo mesmo caminho auditado de qualquer
# programa: sem shell, ambiente mínimo e o programa precisa estar no catálogo
# (docker, npx, uvx, python3…). Programa fora do catálogo pede confirmação na tela.
#
# risk_floor é o piso de risco das ferramentas desse servidor: GREEN, YELLOW ou
# RED (padrão YELLOW). O servidor só consegue subir o risco, nunca descer.
# Se as ferramentas mudarem depois de uma atualização, elas ficam suspensas até
# você aprovar a nova lista na janela do Zordon.
#
# [[mcp.server]]
# name       = "git"
# command    = ["uvx", "mcp-server-git", "--repository", "/home/voce/dev/projeto"]
# risk_floor = "YELLOW"
# autostart  = true

# ─── Base de conhecimento (docs/specs/rag/SPEC-028-base-de-conhecimento.md) ───
#
# As pastas de documentação que o Zordon indexa para responder citando a fonte.
# Só Markdown, só leitura. Sem isto, ele usa o docs/ do repositório do Zordon,
# se o repositório estiver no disco.
#
# [rag]
# roots = ["~/zordon/docs", "~/dev/aurora/docs"]

