# Exemplo de ambiente de DESENVOLVIMENTO do Zordon.
# Copie para .env e preencha. O .env é ignorado pelo Git.
#
# ATENÇÃO: nunca copie valores reais para este arquivo. Ele É versionado.
#
# Em produção o Zordon NÃO usa .env: segredos vivem no Credential Manager do
# Windows e a configuração em ~/.zordon/config.toml, que guarda apenas
# referências no formato secret://<nome>.
# Ver docs/security/model.md §5 e docs/operations/install.md.

# ─── Provider de IA ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=<YOUR_API_KEY>

# Provider local compatível com OpenAI (llama.cpp, Ollama, vLLM). Sem chave.
ZORDON_LOCAL_AI_BASE_URL=http://localhost:11434/v1

# ─── Núcleo ───────────────────────────────────────────────────────────────────
ZORDON_HOME=<HOME>/.zordon
ZORDON_PORT=8777
ZORDON_BIND_ADDRESS=auto
ZORDON_LOG_LEVEL=INFO

# ─── Caminhos (ajuste para a sua máquina) ─────────────────────────────────────
# O usuário do WSL e o do Windows podem ter nomes diferentes.
# Ver docs/architecture/windows-wsl.md §R21.
ZORDON_WSL_HOME=/home/<user>
ZORDON_WINDOWS_HOME=/mnt/c/Users/<user>
ZORDON_WORKSPACES=/home/<user>/dev

# ─── Voz (opcional) ───────────────────────────────────────────────────────────
ZORDON_STT_MODEL=small
ZORDON_STT_DEVICE=adaptive
ZORDON_TTS_VOICE=pt_BR-faber-medium

# ─── Orçamento ────────────────────────────────────────────────────────────────
ZORDON_BUDGET_PER_DAY_USD=10.00
ZORDON_BUDGET_PER_MONTH_USD=100.00
